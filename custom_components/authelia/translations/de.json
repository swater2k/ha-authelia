  "issues": {
    "agent_auth_failed": {
      "title": "Authelia-Agent lehnt das Token ab",
      "description": "Der Datenbank-Agent von **{title}** lehnt das hinterlegte Token ab. Sperren, Anmeldeverlauf, Benutzer und Konfiguration werden nicht aktualisiert.\n\nToken auf dem Authelia-Host mit `grep AGENT_TOKEN /etc/authelia-ha-agent/agent.env` prüfen und unter **Einstellungen → Geräte & Dienste → Authelia → Konfigurieren** aktualisieren."
    },
    "users_without_2fa": {
      "title": "Authelia-Benutzer ohne zweiten Faktor",
      "description": "Diese aktiven Benutzer von **{title}** haben weder TOTP, WebAuthn noch Duo registriert: **{users}**.\n\nSie erreichen nur Ressourcen mit `one_factor`-Richtlinie – oder registrieren beim ersten Zugriff auf eine `two_factor`-Ressource einen zweiten Faktor. Das kann jeder, der das Passwort kennt. Registriere für diese Benutzer einen zweiten Faktor.\n\nDiese Warnung lässt sich in den Optionen der Integration abschalten."
    },
    "legacy_password_hash": {
      "title": "Authelia-Benutzer mit veraltetem Passwort-Hash",
      "description": "Diese Benutzer von **{title}** verwenden ein nicht mehr empfohlenes Hash-Verfahren: **{users}**.\n\nErzeuge mit `authelia crypto hash generate argon2` einen neuen Hash und ersetze ihn in der Benutzerdatenbank."
    },
    "default_policy_not_deny": {
      "title": "Authelia-Standard-Richtlinie ist nicht „deny“",
      "description": "Die `access_control.default_policy` von **{title}** ist `{policy}`. Anfragen, auf die keine Regel passt, werden damit nicht abgelehnt.\n\nSetze `default_policy: 'deny'` und erlaube Zugriffe gezielt über Regeln."
    },
    "webauthn_clone_warning": {
      "title": "Möglicherweise geklonter WebAuthn-Schlüssel",
      "description": "Authelia hat diese WebAuthn-Schlüssel von **{title}** markiert, weil ihr Signaturzähler zurückgesprungen ist: **{credentials}**.\n\nDas kann auf einen geklonten Sicherheitsschlüssel hindeuten. Prüfe das Gerät mit dem Besitzer, entferne den Schlüssel in Authelia und registriere ihn neu."
    }
  }
